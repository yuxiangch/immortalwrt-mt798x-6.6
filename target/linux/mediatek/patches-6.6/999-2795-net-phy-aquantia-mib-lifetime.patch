diff --git a/drivers/net/phy/aquantia/aquantia_mib.c b/drivers/net/phy/aquantia/aquantia_mib.c
index 99c5237..63e141e 100644
--- a/drivers/net/phy/aquantia/aquantia_mib.c
+++ b/drivers/net/phy/aquantia/aquantia_mib.c
@@ -97,6 +97,18 @@ static int aqr107_mib_show(struct seq_file *m, void *private)
 	struct phy_device *phydev = m->private;
 	struct aqr107_priv *priv = phydev->priv;
 
+	/*
+	 * Serialize against aqr_mib_remove(): the node can be removed
+	 * while an already opened fd is still readable, and the PHY
+	 * registers must not be touched after the MDIO bus went away.
+	 */
+	mutex_lock(&priv->mib_lock);
+
+	if (priv->mib_removed) {
+		mutex_unlock(&priv->mib_lock);
+		return 0;
+	}
+
 	aqr107_mib_read(phydev);
 
 	seq_printf(m, "+---------------------------------+\n");
@@ -117,37 +129,74 @@ static int aqr107_mib_show(struct seq_file *m, void *private)
 
 	memset(&priv->mib, 0, sizeof(priv->mib));
 
+	mutex_unlock(&priv->mib_lock);
+
 	return 0;
 }
 
 static int aqr107_mib_open(struct inode *inode, struct file *file)
 {
-	return single_open(file, aqr107_mib_show, inode->i_private);
+	struct phy_device *phydev = inode->i_private;
+	int ret;
+
+	/*
+	 * Keep the PHY device (and the devres allocated priv) alive for the
+	 * whole lifetime of the opened file: an already opened fd may still
+	 * be read after the node was removed and the PHY was torn down.
+	 */
+	get_device(&phydev->mdio.dev);
+
+	ret = single_open(file, aqr107_mib_show, phydev);
+	if (ret)
+		put_device(&phydev->mdio.dev);
+
+	return ret;
+}
+
+static int aqr107_mib_release(struct inode *inode, struct file *file)
+{
+	struct seq_file *m = file->private_data;
+	struct phy_device *phydev = m->private;
+	int ret;
+
+	ret = single_release(inode, file);
+	put_device(&phydev->mdio.dev);
+
+	return ret;
 }
 
 int aqr_mib_probe(struct phy_device *phydev)
 {
 	static const struct file_operations fops_mib = {
+		.owner = THIS_MODULE,
 		.open = aqr107_mib_open,
 		.read = seq_read,
 		.llseek = seq_lseek,
-		.release = single_release
+		.release = aqr107_mib_release
 	};
 
 	struct aqr107_priv *priv = phydev->priv;
 	struct dentry *root;
-	char dirname[5];
 
-	snprintf(dirname, sizeof(dirname), "phy%d", phydev->mdio.addr);
+	mutex_init(&priv->mib_lock);
 
+	/*
+	 * dev_name() is unique per mdio device (e.g. "i2c:sfp1:11"),
+	 * unlike the old "phy%d" name which was truncated by the 5 byte
+	 * buffer and collided for PHYs sharing an mdio address.
+	 */
 	root = debugfs_lookup("aquantia", NULL);
 	if (!root) {
 		root = debugfs_create_dir("aquantia", NULL);
-		if (!root)
-			return -ENOMEM;
+		if (IS_ERR_OR_NULL(root))
+			return root ? PTR_ERR(root) : -ENOMEM;
 	}
 
-	debugfs_create_file(dirname, S_IRUGO, root, phydev, &fops_mib);
+	priv->mib_dentry = debugfs_create_file(dev_name(&phydev->mdio.dev),
+					       S_IRUGO, root, phydev, &fops_mib);
+	dput(root);
+	if (IS_ERR(priv->mib_dentry))
+		priv->mib_dentry = NULL;
 
 	if (!priv->mib_thread) {
 		/* create a thread for recording packet counts */
@@ -155,13 +204,41 @@ int aqr_mib_probe(struct phy_device *phydev)
 						  phydev,
 						  "aqr107_mib_thread");
 		if (IS_ERR(priv->mib_thread)) {
+			long err = PTR_ERR(priv->mib_thread);
+
 			phydev_err(phydev,
-				   "failed to create aqr107_mib_thread(%ld)\n",
-				   PTR_ERR(priv->mib_thread));
-			return PTR_ERR(priv->mib_thread);
+				   "failed to create aqr107_mib_thread(%ld)\n", err);
+			priv->mib_thread = NULL;
+			debugfs_remove(priv->mib_dentry);
+			priv->mib_dentry = NULL;
+			return err;
 		}
 		wake_up_process(priv->mib_thread);
 	}
 
 	return 0;
 }
+
+void aqr_mib_remove(struct phy_device *phydev)
+{
+	struct aqr107_priv *priv = phydev->priv;
+
+	/*
+	 * Stop the polling thread first: it touches PHY registers on its
+	 * own and must not outlive the phy_device. It never takes
+	 * mib_lock and kthread_stop() is called without holding it, so
+	 * this cannot deadlock with the debugfs path below.
+	 */
+	if (priv->mib_thread) {
+		kthread_stop(priv->mib_thread);
+		priv->mib_thread = NULL;
+	}
+
+	/* Defuse a possibly still opened debugfs fd, then drop the node. */
+	mutex_lock(&priv->mib_lock);
+	priv->mib_removed = true;
+	mutex_unlock(&priv->mib_lock);
+
+	debugfs_remove(priv->mib_dentry);
+	priv->mib_dentry = NULL;
+}
